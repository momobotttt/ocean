# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# 只放喺 Vercel（唔好加 NEXT_PUBLIC_），用嚟開／停員工帳戶
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# 客戶資料加密鑰匙：32 bytes base64。產生方法見 README。遺失 = 資料無法解密，請另外安全保存。
DATA_ENCRYPTION_KEY=

# ---- WhatsApp 助手（可選）----
# Claude API key（console.anthropic.com → API Keys）
ANTHROPIC_API_KEY=
# Meta WhatsApp Cloud API（developers.facebook.com → 你個 App → WhatsApp → API Setup）
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# 自己作一串隨機字，設定 webhook 時要填同一串
WHATSAPP_VERIFY_TOKEN=
# 顯示喺 app 入面俾員工撳嘅助手號碼，例如 +852 5xxx xxxx
WHATSAPP_DISPLAY_NUMBER=
# 系統網址（回覆連結用），例如 https://你的網址.vercel.app
APP_URL=
